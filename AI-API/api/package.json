{
  "name": "app",
  "version": "1.0.0",
  "description": "Lightweight Node.js service with BullMQ and secret-key middleware (TypeScript)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "worker": "node dist/queues/worker.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "dev:worker": "ts-node-dev --respawn --transpile-only src/queues/worker.ts",
    "purge:legacy-jobs": "ts-node --transpile-only src/queues/purge-legacy-jobs.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:baseline": "tsx scripts/baseline-migrations.ts",
    "db:pipeline-setup": "tsx src/db/migrate.ts",
    "migrate": "tsx src/db/migrate.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@qdrant/js-client-rest": "^1.20.0",
    "axios": "^1.5.0",
    "bullmq": "^6.3.11",
    "dotenv": "^16.1.4",
    "drizzle-orm": "^0.45.3",
    "express": "^4.18.2",
    "form-data": "^4.0.6",
    "ioredis": "^5.3.2",
    "jose": "^6.2.13",
    "js-tiktoken": "^1.0.21",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.2.0",
    "postgres": "^3.4.9",
    "redis": "^6.3.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^4.6.3",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.7",
    "@types/node": "^20.6.0",
    "@types/pg": "^8.23.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.4",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.11",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.3.0"
  }
}
