# --- App ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Auth: RS256 service JWT via JWKS (preferred; issued by app-api) ---
# Docker: http://app-api:3001/.well-known/jwks.json
SERVICE_JWKS_URL=http://127.0.0.1:3001/.well-known/jwks.json
SERVICE_JWT_ISSUER=http://localhost:3001
SERVICE_JWT_AUDIENCE=app-ai

# --- Legacy shared secret (dual-accept during rollout; remove after cutover) ---
SECRET_KEY=replace_with_secret_key
# Same value as SECRET_KEY — auth accepts either as x-api-key / Bearer static
API_SECRET=replace_with_secret_key

# Browser CORS discouraged — browsers should use app-api BFF only.
# CORS_ORIGINS=https://insursa-widget.intellikast.in
CORS_ALLOW_SUBDOMAINS_OF=intellikast.in

# --- Postgres (same DB as app-api) ---
# Product schema (documents, faqs, summaries, …): app-api ONLY
#   cd ../app-api && npm run db:migrate
#   (existing DBs) npm run db:ensure-document-pipeline
#   (shared files) npm run db:ensure-shared-files
# Pipeline-only tables: npm run migrate  (or db:pipeline-setup)
# Option A — discrete vars
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Option B — URL (password may include @; %40 encoding also works)
# POSTGRES_URL=postgresql://postgres:p@ss@localhost:5432/app_db


# --- Redis (required by platform config; BullMQ can also use REDIS_URL) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379
REDIS_HISTORY_CACHE_TTL=3600
REDIS_HISTORY_LIMIT=50

# --- Qdrant ---
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=local-dev-key

# --- LLM / summarization (conversation memory) ---
SUMMARIZATION_MODEL=qwen3:8b
SUMMARIZATION_TOKEN_THRESHOLD=2000
SUMMARIZATION_INPUT_COST_PER_MILLION=0.15
SUMMARIZATION_OUTPUT_COST_PER_MILLION=0.6
LLM_CHEAP_MODEL=qwen3:8b
EMBEDDING_COST_PER_MILLION=0
FRAMEWORK=haystack

# --- Uploads / document pipeline ---
UPLOAD_DIR=./uploads
# 3 delayed retries after first failure (30s → 60s → 90s). Total attempts = 4.
DOCUMENT_RETRY_LIMIT=3
DOC_JOB_ATTEMPTS=4
DOC_JOB_BACKOFF_MS=30000,60000,90000
HEARTBEAT_INTERVAL_MS=30000
RECONCILE_INTERVAL_MS=300000
STUCK_JOB_THRESHOLD_MS=600000
DOCUMENT_EXTRACTION_URL=http://localhost:8001/extract
DOCUMENT_INTERPRET_URL=http://localhost:8000/interpret
OLLAMA_BASE_URL=http://localhost:11434
INTERPRET_MODEL=gemma4:e4b
HAYSTACK_INGEST_URL=http://localhost:8000/ingest/
FAQ_GENERATE_URL=http://localhost:8002/generate-faqs
SUMMARY_GENERATE_URL=http://localhost:8002/generate-summary
# Must match app/.env FAQ_Ai_API_KEY (worker sends as x-api-key)
FAQ_Ai_API_KEY=replace_with_secret_key

# Optional ingest model override for POST /ingest. Leave unset so haystack
# EMBEDDING_PROVIDER / EMBEDDING_MODEL / EMBEDDING_DIMENSION win.
# If set, must match the haystack embedding preset (mini or bge).
# INGEST_EMBEDDING_MODEL=bge-m3
# EMBEDDING_MODEL=bge-m3
# Qdrant collections by upload source
QDRANT_COLLECTION_CUSTOMER=customer
QDRANT_COLLECTION_GENERAL=general

# Step HTTP timeouts (ms) — upload always returns 202
EXTRACT_TIMEOUT_MS=900000
INTERPRET_TIMEOUT_MS=600000
INGEST_TIMEOUT_MS=900000
FAQ_TIMEOUT_MS=1800000
FAQ_POLL_INTERVAL_MS=3000
JOB_LOCK_DURATION_MS=2700000
# Haystack ingest needs Qdrant (default http://localhost:6333)

# Workers
DOC_PRIORITY_CONCURRENCY=3
DOC_NORMAL_CONCURRENCY=1

# --- Ingestion file / artifact retention (worker) ---
# customer: after N days delete file + Qdrant vectors + FAQs/summaries + pipeline rows
# admin: after N days delete uploaded file only (keep FAQs / vectors / DB)
# Set a days value to 0 to disable that source. RETENTION_ENABLED=false disables all.
RETENTION_ENABLED=true
RETENTION_CUSTOMER_DAYS=30
RETENTION_ADMIN_FILE_DAYS=90
RETENTION_INTERVAL_MS=86400000

# --- RAG testing pipeline (POST /api/testing/runs) ---
# Default Excel of Q&A when multipart field "questions" is omitted
# RAG_TEST_QUESTIONS_PATH=D:\Downloads\RAG Questions - Insursa Motor 1.xlsx
# RAG_TEST_REPORTS_DIR=./reports/rag-tests
# RAG_TEST_POLL_MS=5000
# RAG_TEST_INGEST_TIMEOUT_MS=3600000

# Cutover / key rotation: see ../../app-api/docs/AUTH_CUTOVER.md

