APP_ENV=production
DEBUG=false

DEFAULT_LLM_PROVIDER=ollama
DEFAULT_LLM_MODEL=

OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=1536

QDRANT_API_KEY=
QDRANT_COLLECTION=document_chunks

QDRANT_VERSION=v1.15.4
OLLAMA_VERSION=latest
AI_VERSION=local
DOC_EXTRACT_VERSION=local

AI_HOST_PORT=8000
DOC_EXTRACT_HOST_PORT=8001
QDRANT_HOST_PORT=6333
QDRANT_GRPC_HOST_PORT=6334
OLLAMA_HOST_PORT=11434

# Document extraction / scanned OCR
LAYOUT_PROVIDER=paddleocr
LAYOUT_MODEL=PP-DocLayout_plus-L
TEXT_OCR_PROVIDER=tesseract
TESSERACT_CMD=
TESSERACT_LANG=eng
EXTRACTION_DEBUG=false
EXTRACTION_DEBUG_DIR=debug/extraction
PDF_OCR_DPI=200
SCANNED_MIN_TEXT_CHARS=20
