# Document extraction service (copy to .env)
# Run: python run.py  → http://127.0.0.1:8001

# Server (use 127.0.0.1 on Windows to avoid WinError 10013)
HOST=127.0.0.1
PORT=8001

# Scanned PDF OCR pipeline
# Use fullpage on Windows if Paddle oneDNN crashes; switch back to paddleocr later.
LAYOUT_PROVIDER=paddleocr
LAYOUT_MODEL=PP-DocLayout_plus-L
TEXT_OCR_PROVIDER=tesseract

# Windows example:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
TESSERACT_LANG=eng
TESSERACT_CONFIG=

EXTRACTION_DEBUG=false
EXTRACTION_DEBUG_DIR=debug/extraction
PDF_OCR_DPI=200
SCANNED_MIN_TEXT_CHARS=20
LAYOUT_SCORE_THRESHOLD=0.3
