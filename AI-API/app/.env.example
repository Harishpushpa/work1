# FAQ generator service (copy to .env)
# Run: python app/run.py  → http://127.0.0.1:8002
#
# LLM: Haystack shared adapter via HTTP (same provider/model as chat + interpret)

HOST=127.0.0.1
PORT=8002

FAQ_Ai_API_KEY=replace_with_secret_key
MAX_UPLOAD_MB=25

# Haystack common LLM + embeddings. Leave EMBED_MODEL empty so haystack
# EMBEDDING_PROVIDER / EMBEDDING_MODEL / EMBEDDING_DIMENSION win.
LLM_GENERATE_URL=http://127.0.0.1:8000/llm/generate
# Section LLM calls (RunPod) — raise if FAQ sections time out
LLM_TIMEOUT_SECONDS=600
EMBED_URL=http://127.0.0.1:8000/embed
EMBED_MODEL=
# FAQ dedupe embed via haystack/Ollama — 120s is too low for ~50 bge-m3 texts
EMBED_TIMEOUT_SECONDS=900
NUM_CTX=8192

CHUNK_MIN_CHARS=900
CHUNK_MAX_CHARS=3500
CHUNK_OVERLAP_CHARS=75

FAQ_MIN_PER_SECTION=1
FAQ_MAX_PER_SECTION=12
DUPLICATE_THRESHOLD=0.9
SUMMARY_MAX_LINES=5
OCR_CONFIDENCE_THRESHOLD=75
PROMPT_VERSION=v1

CALLBACK_URL=
FAQ_CALLBACK_URL=
SUMMARY_CALLBACK_URL=
CALLBACK_API_KEY=
CALLBACK_ATTEMPTS=3
CALLBACK_RETRY_SECONDS=2
JOBS_KEEP=50
