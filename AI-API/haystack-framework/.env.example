# Haystack RAG service (copy to .env)
# Run: python run.py
#   or: uvicorn app.main:app --host 127.0.0.1 --port 8000
# HOST=127.0.0.1
# PORT=8000
#
# Shared LLM HTTP API for FAQ / summary / interpret:
#   POST /llm/generate  { endpoint, messages, json_mode, ... }
# FAQ service calls this via LLM_GENERATE_URL (see app/.env.example).

APP_NAME=Haystack RAG Service
APP_ENV=development
DEBUG=false

# ---------------------------------------------------------------------------
# LLM — ONE place for model decisions (app.config.llm.resolve_llm)
# Chat / interpret / faq / summary use DEFAULT_* unless overridden below.
# ---------------------------------------------------------------------------
DEFAULT_LLM_PROVIDER=runpod
DEFAULT_LLM_MODEL=unsloth/gemma-4-E4B-it-GGUF:Q4_K_M

# Optional overrides (leave empty to inherit DEFAULT_*)
LLM_CHAT_PROVIDER=
LLM_CHAT_MODEL=
LLM_INTERPRET_PROVIDER=
LLM_INTERPRET_MODEL=
# Interpret context window + chunking (auto-splits if prompt exceeds n_ctx)
INTERPRET_NUM_CTX=8192
INTERPRET_MAX_TOKENS=512
INTERPRET_CTX_SAFETY=256
LLM_FAQ_PROVIDER=
LLM_FAQ_MODEL=
LLM_SUMMARY_PROVIDER=
LLM_SUMMARY_MODEL=
LLM_VLM_PROVIDER=ollama_vlm
LLM_VLM_MODEL=llava:latest

OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

OLLAMA_URL=http://localhost:11434
# Seconds — raise for slow local models (Haystack default is 120)
OLLAMA_TIMEOUT=600

# Groq (OpenAI-compatible) — used when DEFAULT_LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# RunPod (OpenAI-compatible) — used when DEFAULT_LLM_PROVIDER=runpod
# Base URL must end with /v1 (chat path is /v1/chat/completions)
RUNPOD_API_KEY=
RUNPOD_BASE_URL=https://o8rmdb4mb45e07-8000.proxy.runpod.net/v1

# Common LLM adapter — concurrency + rate limits (requests/minute)
LLM_OLLAMA_MAX_CONCURRENCY=1
LLM_OLLAMA_RPM=30
LLM_OLLAMA_VLM_MAX_CONCURRENCY=1
LLM_OLLAMA_VLM_RPM=20
LLM_GROQ_MAX_CONCURRENCY=5
LLM_GROQ_RPM=60
LLM_RUNPOD_MAX_CONCURRENCY=2
LLM_RUNPOD_RPM=60
LLM_DEFAULT_MAX_CONCURRENCY=2
LLM_DEFAULT_RPM=60
LLM_AUDIT_PATH=data/llm_usage_audit.jsonl

# Embeddings — same provider/model/dim for ingest, chat retrieval, and POST /embed.
# Changing dimension requires re-ingest (Qdrant collection size must match).
#
# Preset mini (local sentence-transformers):
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
#
# Preset bge (Ollama):
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_DIMENSION=1024
# Per-batch HTTP timeout (seconds) and chunk batch size for Ollama /api/embed
EMBEDDING_OLLAMA_TIMEOUT=900
EMBEDDING_OLLAMA_BATCH_SIZE=16
#
# Preset RunPod (OpenAI-compatible /v1/embeddings):
# EMBEDDING_PROVIDER=runpod
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_DIMENSION=1024
# Optional — leave empty to reuse RUNPOD_BASE_URL / RUNPOD_API_KEY
# EMBEDDING_RUNPOD_BASE_URL=https://<id>-8000.proxy.runpod.net/v1
# EMBEDDING_RUNPOD_API_KEY=
# EMBEDDING_RUNPOD_TIMEOUT=900
# EMBEDDING_RUNPOD_BATCH_SIZE=16


QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Shared contract: customer uploads → customer; admin → general
# Chat search queries both collections.
QDRANT_COLLECTION=general
QDRANT_COLLECTION_CUSTOMER=customer
QDRANT_COLLECTION_GENERAL=general

RETRIEVAL_TOP_K=5
MAX_CONTEXT_TOKENS=2500
CHUNK_SIZE=400
CHUNK_OVERLAP=50
MAX_AGENT_STEPS=5
MAX_TOOL_CALLS=2
MAX_RECENT_MESSAGES=6
MAX_CONVERSATION_CONTEXT_TOKENS=1200
